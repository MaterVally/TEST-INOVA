# =============================================================
# Enterprise Compliance Intelligence Platform — Environment Config
# =============================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to git.
# =============================================================


# -------------------------------------------------------------
# TEXT LLM (entity extraction, relation building, RAG answers)
# Uses OpenAI gpt-4o via api.openai.com
# -------------------------------------------------------------
LLM_API_KEY=your_openai_api_key_here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o


# -------------------------------------------------------------
# MULTIMODAL LLM (image understanding, visual entity extraction)
# gpt-4o supports vision natively — same key and endpoint as text LLM.
# -------------------------------------------------------------
MM_API_KEY=your_openai_api_key_here
MM_API_BASE=https://api.openai.com/v1
MM_MODEL_NAME=gpt-4o


# -------------------------------------------------------------
# EMBEDDING MODEL (semantic search over knowledge graph nodes)
# Can be a local path OR a HuggingFace model name.
# Local path (download once): ./models/all-MiniLM-L6-v2
# HuggingFace auto-download:  sentence-transformers/all-MiniLM-L6-v2
# -------------------------------------------------------------
EMBEDDING_MODEL_DIR=sentence-transformers/all-MiniLM-L6-v2


# -------------------------------------------------------------
# DIRECTORY PATHS (relative to project root)
# -------------------------------------------------------------
INPUT_PDF_PATH=data/input/
CACHE_PATH=data/cache
WORKING_DIR=data/working
OUTPUT_DIR=data/output
MMKG_NAME=example_mmkg


# -------------------------------------------------------------
# PROCESSING PARAMETERS
# -------------------------------------------------------------
USE_MINERU=false
ENTITY_EXTRACT_MAX_GLEANING=0
ENTITY_SUMMARY_MAX_TOKENS=500
SUMMARY_CONTEXT_MAX_TOKENS=10000


# -------------------------------------------------------------
# RETRIEVAL PARAMETERS
# -------------------------------------------------------------
RETRIEVAL_THRESHOLD=0.2


# -------------------------------------------------------------
# OPENAI API KEY (audio transcription — Whisper)
# Same key as LLM_API_KEY — set once, used for text, vision, and audio.
# -------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here


# -------------------------------------------------------------
# SUPABASE AUTH CONFIGURATION
# Get these from: https://supabase.com/dashboard → your project → Settings → API
# -------------------------------------------------------------
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret


# -------------------------------------------------------------
# CORS
# Comma-separated list of allowed frontend origins (no trailing slash)
# -------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
