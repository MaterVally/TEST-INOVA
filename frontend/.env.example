VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# API base URL
# Development: leave empty — Vite's dev server proxies /api/* to the backend
#              (proxy target defaults to http://localhost:8000, see vite.config.ts)
# Production:  set to your deployed backend origin with no trailing slash, e.g.
#              VITE_API_BASE=https://your-backend.onrender.com
VITE_API_BASE=
